# Upbit 개인 API 키는 필요하지 않습니다.
UPBIT_BASE_URL=https://api.upbit.com
REQUEST_TIMEOUT_SECONDS=10
# 공개 REST 요청을 초당 한도 아래로 조절하고 429/일시 오류를 재시도
UPBIT_REQUEST_INTERVAL_SECONDS=0.12
UPBIT_RETRY_ATTEMPTS=4

# 실시간 공개 체결 감시 (업비트 개인 API 키 불필요)
ENABLE_MARKET_MONITOR=true
MONITOR_MARKETS=ALL_KRW
MONITOR_PRICE_SURGE_1M_PCT=1.5
MONITOR_BREAKOUT_PCT=0.4
MONITOR_VOLUME_RATIO=2.0
MONITOR_MIN_TRADE_VALUE_KRW=50000000
MONITOR_ALERT_COOLDOWN_SECONDS=600
MONITOR_MAX_ALERTS_PER_MINUTE=5

# 30분 이상 좁은 횡보 후 거래대금이 급증하며 상단을 재돌파하는 신호
MONITOR_REBREAKOUT_ENABLED=true
MONITOR_REBREAKOUT_CONSOLIDATION_SECONDS=1800
MONITOR_REBREAKOUT_MAX_RANGE_PCT=3.0
MONITOR_REBREAKOUT_PRICE_BUFFER_PCT=0.3
MONITOR_REBREAKOUT_MIN_VOLUME_RATIO=3.0
# 최근 5·15·60분 모멘텀으로 전체 KRW 시장의 상대강도 상위 10%를 선별
MONITOR_RELATIVE_STRENGTH_ENABLED=true
MONITOR_RELATIVE_STRENGTH_MIN_UNIVERSE=80
MONITOR_RELATIVE_STRENGTH_TOP_PERCENT=10
MONITOR_RELATIVE_STRENGTH_MIN_5M_PCT=1.0
MONITOR_RELATIVE_STRENGTH_STALE_SECONDS=120
# 한국시간 08:45~09:15 거래대금 선행 가속 종목을 Telegram 없이 내부 등록
MONITOR_PRELEADER_ENABLED=true
MONITOR_PRELEADER_START_KST=08:45
MONITOR_PRELEADER_END_KST=09:15
MONITOR_PRELEADER_CHECK_INTERVAL_SECONDS=15
MONITOR_PRELEADER_MIN_VALUE_RATIO_10M=2.0
MONITOR_PRELEADER_MIN_VALUE_RATIO_30M=1.5
MONITOR_PRELEADER_MIN_3M_PCT=0.4
MONITOR_PRELEADER_MIN_5M_PCT=0.6
MONITOR_PRELEADER_MAX_PERCENTILE=20
MONITOR_PRELEADER_RANK_IMPROVEMENT_PCT=5
MONITOR_PRELEADER_COOLDOWN_SECONDS=1800

# 상승 신호 후 다음 완료 1분봉까지 기다려 구조와 시장 환경을 재검증
ENABLE_CANDIDATE_ANALYSIS=false
CANDIDATE_CONFIRM_SECONDS=30
# 첫 심층검증을 통과해도 60초 뒤 가격·거래량·호가가 생존한 경우에만 전송
CANDIDATE_SURVIVAL_CONFIRM_SECONDS=60
CANDIDATE_MIN_SCORE=90
CANDIDATE_COOLDOWN_SECONDS=900
# 같은 종목의 후보 메시지는 기본 4시간 동안 다시 보내지 않음
CANDIDATE_REPEAT_COOLDOWN_SECONDS=14400
CANDIDATE_VALID_SECONDS=300
CANDIDATE_MAX_DAY_CHANGE_PCT=20
# 선호 RSI 초과는 감점, hard 기준 초과만 탈락
CANDIDATE_MAX_RSI_1M=78
CANDIDATE_MAX_RSI_5M=75
CANDIDATE_HARD_MAX_RSI_1M=88
CANDIDATE_HARD_MAX_RSI_5M=85
CANDIDATE_RSI_SCORE_PENALTY=4
# 0.8 미만은 감점. 0.4 미만은 '매우 약함'으로 표시하되 호가만으로 탈락시키지 않음
CANDIDATE_MIN_ORDERBOOK_RATIO=0.8
CANDIDATE_HARD_MIN_ORDERBOOK_RATIO=0.4
CANDIDATE_MAX_PRICE_EXTENSION_PCT=2.0
CANDIDATE_MIN_COMPLETED_VOLUME_RATIO=1.2
CANDIDATE_MIN_VOLUME_VS_PREVIOUS=0.65
CANDIDATE_MIN_CLOSE_POSITION=0.6
CANDIDATE_MAX_UPPER_WICK_RATIO=0.4
# 0.5% 초과는 감점, 1.2% 초과는 탈락
CANDIDATE_MAX_SPREAD_PCT=0.5
CANDIDATE_HARD_MAX_SPREAD_PCT=1.2
CANDIDATE_MIN_TRADE_VALUE_24H_KRW=1000000000
# 저항 여유 5% 미만은 감점, 2.5% 미만은 탈락
CANDIDATE_MIN_RESISTANCE_ROOM_PCT=5
CANDIDATE_HARD_MIN_RESISTANCE_ROOM_PCT=2.5
CANDIDATE_MIN_RISK_REWARD=2
CANDIDATE_MAX_STOP_LOSS_PCT=3
CANDIDATE_MAX_BTC_DECLINE_PCT=-1.5
# 위험회피 시장, 약한 호가의 상충 조건은 점수와 무관하게 하드차단
CANDIDATE_HARD_MIN_MARKET_BREADTH_PCT=35
CANDIDATE_BTC_WEAK_MIN_ORDERBOOK_RATIO=1.0
CANDIDATE_HOT_RSI_1M=75
CANDIDATE_ORDERBOOK_SAMPLE_COUNT=3
CANDIDATE_ORDERBOOK_SAMPLE_INTERVAL_SECONDS=2
CANDIDATE_REENTRY_WINDOW_SECONDS=1800
CANDIDATE_REENTRY_COOLDOWN_SECONDS=300
# 최초 탈락 후보도 12시간 내부 관찰하고, 횡보 재돌파 때 다시 평가
CANDIDATE_WATCHLIST_WINDOW_SECONDS=43200
# 모든 원시 상승 신호의 +5%/-3% 선도달 성과를 별도로 기록
CANDIDATE_RAW_SIGNAL_TARGET_PCT=5
CANDIDATE_RAW_SIGNAL_STOP_PCT=3
# BTC 약세와 당일 과열은 자동 탈락 대신 조건점수에서 감점
CANDIDATE_BTC_WEAK_SCORE_PENALTY=10
CANDIDATE_DAY_OVERHEAT_SCORE_PENALTY=8
CANDIDATE_ORDERBOOK_SCORE_PENALTY=4
CANDIDATE_SPREAD_SCORE_PENALTY=4
CANDIDATE_RESISTANCE_SCORE_PENALTY=6
# 정확도 우선 운영에서는 경미한 품질 미달 완화도 비활성화합니다.
# 아래 세부값은 운영 실험에서 기능을 명시적으로 켤 때만 사용됩니다.
CANDIDATE_AVAILABILITY_BALANCE_ENABLED=false
CANDIDATE_AVAILABILITY_MAX_SOFT_WARNINGS=2
CANDIDATE_AVAILABILITY_SOFT_PENALTY=4
CANDIDATE_AVAILABILITY_MIN_VOLUME_RATIO=0.85
CANDIDATE_AVAILABILITY_MIN_VOLUME_VS_PREVIOUS=0.45
CANDIDATE_AVAILABILITY_MIN_CLOSE_POSITION=0.35
CANDIDATE_AVAILABILITY_MAX_UPPER_WICK_RATIO=0.65
CANDIDATE_AVAILABILITY_RESISTANCE_FLOOR_PCT=1.5
# 보완 기능을 다시 켜더라도 90점 아래 후보는 허용하지 않습니다.
CANDIDATE_AVAILABILITY_MIN_SCORE=90
# 시장 전체 순위가 준비되면 상위 상대강도와 첫 눌림·재지지를 필수 확인
CANDIDATE_RELATIVE_STRENGTH_REQUIRED=true
CANDIDATE_RELATIVE_STRENGTH_TOP_PERCENT=10
CANDIDATE_RELATIVE_STRENGTH_MIN_5M_PCT=1.0
CANDIDATE_RELATIVE_STRENGTH_SCORE_BONUS=8
CANDIDATE_EARLY_TREND_REQUIRED=true
CANDIDATE_REQUIRE_FIRST_RETEST=true
CANDIDATE_RETEST_TOLERANCE_PCT=0.8
# 원시 신호에서 탈락한 상대강도 선도주도 첫 눌림(1~5%) 뒤 0.5% 재돌파 시 재검증
CANDIDATE_LEADER_WATCH_ENABLED=true
CANDIDATE_LEADER_WATCH_MAX_RECHECKS=3
CANDIDATE_LEADER_PULLBACK_MIN_PCT=1.0
CANDIDATE_LEADER_PULLBACK_MAX_PCT=5.0
CANDIDATE_LEADER_RECLAIM_PCT=0.5
CANDIDATE_LEADER_RECHECK_COOLDOWN_SECONDS=300
# 상위 추세 후보는 1차 후 진입가를 보호하고 10·15·20% 구간을 최대 6시간 추적
CANDIDATE_TREND_TARGET_2_PCT=10
CANDIDATE_TREND_TARGET_3_PCT=15
CANDIDATE_TREND_TARGET_4_PCT=20
CANDIDATE_TREND_TRACKING_SECONDS=21600
# 1차 목표와 손절의 선도달 평가는 30분이 아닌 최소 2시간 추적
CANDIDATE_OUTCOME_TRACKING_SECONDS=7200

# Telegram 알림은 두 값을 모두 Railway 환경변수에만 등록합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 내부 감시는 유지하면서 Telegram 메시지 유형만 선택합니다.
TELEGRAM_SEND_OBSERVATION_ALERTS=true
TELEGRAM_SEND_CANDIDATE_ALERTS=true
# 전송 후보의 목표·손절·진입가 보호 도달을 조건부 후속 안내
TELEGRAM_SEND_MANAGEMENT_ALERTS=true
# 08:45~09:15 거래대금 선행 가속은 진입 후보와 분리해 초기 포착으로 제한 전송
TELEGRAM_SEND_EARLY_WATCH_ALERTS=true
TELEGRAM_EARLY_WATCH_DAILY_MAX=8
# 2차 확장 목표가 5% 이상인 후보만 전송. 1차 목표·저항 여유는 단독 차단하지 않음
TELEGRAM_CANDIDATE_MIN_TARGET_2_PCT=5
# 정확도 우선: 조건점수 90점 이상인 후보만 Telegram 전송
TELEGRAM_CANDIDATE_MIN_SCORE=90
# 한국시간 기준 하루 후보 5~10개 관찰 목표, 최대 10개 제한
TELEGRAM_DAILY_CANDIDATE_MIN=5
TELEGRAM_DAILY_CANDIDATE_MAX=10
TELEGRAM_AVAILABILITY_MIN_INTERVAL_SECONDS=5400
# 조건부 후보가 없더라도 서비스 생존과 최근 선별 현황을 1시간마다 요약
TELEGRAM_SEND_INACTIVITY_STATUS=true
TELEGRAM_INACTIVITY_STATUS_SECONDS=3600
# 한국시간 23:50에 서비스 재시작 이후 모의 후보 성과를 자동 요약
TELEGRAM_SEND_DAILY_PERFORMANCE=true
TELEGRAM_DAILY_PERFORMANCE_TIME_KST=23:50
# 수수료와 예상 슬리피지를 합산한 후보당 왕복 비용 가정
CANDIDATE_SIMULATED_ROUND_TRIP_COST_PCT=0.2
