diff --git a/test_lbank_entry_evidence.py b/test_lbank_entry_evidence.py
new file mode 100644
index 0000000..a0de714
--- /dev/null
+++ b/test_lbank_entry_evidence.py
@@ -0,0 +1,83 @@
+import copy
+import json
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+import lbank_entry_evidence as evidence
+from test_lbank_entry_quality import structural_state
+from test_lbank_confirmation_cadence import run_clock
+import lbank_futures_monitor as monitor
+
+
+class EntryEvidenceTests(unittest.TestCase):
+    def test_public_whitelist_and_freeze_never_copy_account_fields(self):
+        state=structural_state()
+        state['prices']=[b['close'] for b in state['minute_bars']]
+        state['rsi5']={'closes':[],'rsi':[]}
+        state['account_token']='must-not-copy'
+        state['minute_bars'][-1]['private']='must-not-copy'
+        plan={'direction':1,'price':state['quote'],'account':'must-not-copy'}
+        raw=evidence.freeze_event('setup',9000.,state,plan=plan,
+                                  model_config={'fee':.0006,'account':'must-not-copy'})
+        self.assertEqual(json.loads(raw)['model_config'],{'fee':.0006})
+        old=json.loads(raw)['native_state']['minute_bars'][-1]['close']
+        state['minute_bars'][-1]['close']=1
+        self.assertEqual(json.loads(raw)['native_state']['minute_bars'][-1]['close'],old)
+        self.assertNotIn('must-not-copy',raw.decode())
+
+    def test_real_snapshot_archive_roundtrip_and_corruption_is_rejected(self):
+        with tempfile.TemporaryDirectory() as directory:
+            rec=evidence.EntryEvidenceRecorder(directory,source_commit='test')
+            self.assertTrue(rec.submit('setup',9000.,structural_state(),plan={'price':80000.}))
+            rec.pending.join()
+            rec.pending.put(None);rec.thread.join(2)
+            envelope=json.loads(next(Path(directory).glob('*.jsonl')).read_text())
+            event=evidence.unpack_archive(envelope)
+            self.assertEqual(event['phase'],'setup')
+            self.assertFalse(event['actual_account_data'])
+            envelope['sha256']='0'*64
+            with self.assertRaises(ValueError):evidence.unpack_archive(envelope)
+
+    def test_bad_filesystem_does_not_block_producer(self):
+        with tempfile.TemporaryDirectory() as directory:
+            p=Path(directory)/'file';p.write_text('not a directory')
+            rec=evidence.EntryEvidenceRecorder(p)
+            self.assertTrue(rec.submit('setup',9000.,structural_state()))
+            rec.pending.join();self.assertEqual(rec.failed,1)
+            rec.pending.put(None);rec.thread.join(2)
+
+    def test_bounded_queue_reports_loss_instead_of_blocking(self):
+        entered=threading.Event();release=threading.Event()
+        with tempfile.TemporaryDirectory() as directory:
+            with patch.object(evidence.EntryEvidenceRecorder,'_write',side_effect=lambda *a:(entered.set(),release.wait(2))):
+                rec=evidence.EntryEvidenceRecorder(directory,queue_size=1)
+                rec.submit('setup',9000.,structural_state());self.assertTrue(entered.wait(1))
+                self.assertTrue(rec.submit('setup',9001.,structural_state()))
+                self.assertFalse(rec.submit('setup',9002.,structural_state()))
+                self.assertEqual(rec.dropped,1)
+                release.set();rec.pending.join()
+                rec.pending.put(None);rec.thread.join(2)
+
+    def test_capture_failure_does_not_change_real_loop_send_risk_or_save_schedule(self):
+        with patch.object(monitor.EntryEvidenceRecorder,'from_environment',return_value=None):
+            baseline=run_clock()
+        rec=Mock();rec.submit.side_effect=OSError('diagnostic only')
+        with patch.object(monitor.EntryEvidenceRecorder,'from_environment',return_value=rec):
+            after=run_clock()
+        for key in ('sent','saved','confirmed','order'):
+            self.assertEqual(baseline[key],after[key],key)
+        self.assertTrue(rec.submit.called)
+        phases=[c.args[0] for c in rec.submit.call_args_list]
+        self.assertIn('setup',phases);self.assertIn('confirmation',phases);self.assertIn('delivered',phases)
+
+    def test_opt_in_is_explicit_and_bad_window_does_not_get_truncated(self):
+        with patch.dict('os.environ',{'LBANK_ENTRY_EVIDENCE_ENABLED':'false'}):
+            self.assertIsNone(evidence.EntryEvidenceRecorder.from_environment())
+        state=structural_state();state['minute_bars']=state['minute_bars']*100
+        with self.assertRaises(ValueError):evidence.freeze_event('setup',9000.,state)
+
+
+if __name__=='__main__':unittest.main()
